---
import { articleUrl, formatDateTime } from "../lib/data";
import type { Correction } from "../lib/data";

interface Props {
  correction: Correction;
}

const { correction } = Astro.props;
---

<article class="corrections-diff">
  <h2><a href={articleUrl(correction.slug)}>{correction.headline}</a></h2>
  <p class="meta">
    <time datetime={correction.corrected_at}
      >{formatDateTime(correction.corrected_at)} UTC</time
    >
  </p>
  <p>{correction.reason}</p>
  <p class="diff-line"><strong>Before:</strong> <del>{correction.before}</del></p>
  <p class="diff-line"><strong>After:</strong> <ins>{correction.after}</ins></p>
</article>
